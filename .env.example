# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- Spotify ----
# Create an app at https://developer.spotify.com/dashboard
# Add redirect URI: http://localhost:3000/api/spotify/callback (and your prod URL)
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# ---- Email (Resend) ----
# https://resend.com/api-keys
# Without this the listening-party check-in still works and awards XP; it just
# doesn't send the "You're all checked in" auto-reply.
RESEND_API_KEY=YOUR_RESEND_API_KEY
# Until you verify a domain in Resend, keep the default sender and note that
# delivery is limited to the Resend account owner's own address.
RESEND_FROM=FanFest <onboarding@resend.dev>
